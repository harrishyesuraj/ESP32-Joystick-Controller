/*
 * ESP32 Game Controller  v2.1   (one analog stick + "+" of five buttons)
 * Developer: HARRISH YESURAJ P
 *
 * LAYOUT (see the architecture document)
 *   Left thumb : five buttons in a "+" : Up, Down, Left, Right, Center
 *   Right thumb: one analog stick (X, Y) with a click button
 *   Default game mapping:  + buttons = D-pad, Center = Select/View, stick = RIGHT stick, click = R3
 *   Any of the six controls can be re-assigned: Settings > Assign buttons
 *   (D-pad, face buttons A B X Y, LB RB LT RT, Select, Start, L3, R3, left-stick directions)
 *
 * MENU KEYS  (menus, lists and games)
 *   Up / Down = move     Right = open / OK     Left = back
 *   Stick click = OK     Center = back / pause
 *   Inside Bluetooth / USB the buttons go to the game; HOLD Center for 1.2 s to open the main menu.
 *
 * BLUETOOTH MODES  (Settings > Gamepad > Mode)
 *   Xbox (XInput)  : shows up as an Xbox controller - works in Windows games, Android, Mac, Linux
 *   Generic PC / Generic Android : plain HID gamepad (web testers, old setups)
 *   Changing between Xbox and Generic needs a restart and a fresh pairing (the board restarts itself).
 *
 * LIBRARIES : Adafruit GFX, Adafruit SSD1306, NimBLE-Arduino, ESP32-BLE-Gamepad 0.8.0 or newer
 *             (install the newest ZIP from github.com/lemmingDev/ESP32-BLE-Gamepad - it adds XInput mode)
 * BOARD     : "ESP32 Dev Module"
 *
 * PINS (from the circuit diagram)
 *   Stick  : VRx 34, VRy 35, SW 13      -> power the stick from 3V3, NOT 5V (ESP32 pins are not 5 V tolerant)
 *   Buttons: 27, 26, 25, 33, 32 (left to right in the diagram; Settings > Button positions sets which is Up/Down/...)
 *   OLED   : SCK 18, MOSI 23, RES 17, DC 16, CS 5          LED: GPIO2 via resistor
 */

#include <Arduino.h>
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Preferences.h>
#include <BleGamepad.h>
#include <stdarg.h>
#include <pgmspace.h>

// ============================== CONFIG ====================================
#define FW_VERSION      "v2.1"
#define SETTINGS_VER    4
#define DEV_NAME        "ESP32 Gamepad"
#define USE_XINPUT      1         // 1 = offer Xbox (XInput) mode. Set 0 if the compiler says 'GamepadMode' is unknown
                                  //     (then update the ESP32-BLE-Gamepad library to 0.8.0+).

#define DEADZONE        0.12f
#define NAV_ON          0.60f
#define NAV_OFF         0.40f
#define NAV_REPEAT_1    400
#define NAV_REPEAT_N    150
#define DEBOUNCE_MS     20
#define FRAME_MS        59        // drawing rate (~17 FPS)
#define HOST_MS         10        // gamepad report period
#define USB_TIMEOUT_MS  3000UL
#define MENU_HOLD_MS    1200      // hold Center on the Bluetooth / USB screen to open the menu

#define LOAD_FRAME_COUNT   6      // game-loading animation: 6 x 120 ms = 720 ms (>= 0.6 s)
#define LOAD_FRAME_MS      120
#define LEVELUP_FRAMES     32     // level-up animation
#define LEVELUP_FRAME_MS   55
#define LEVEL_METERS       100    // Dino: speed-up + level-up every 100 m
#define PX_PER_M           12

// ============================== PINS ======================================
#define SCREEN_W   128
#define SCREEN_H   64
#define OLED_SCK   18
#define OLED_MOSI  23
#define OLED_RESET 17
#define OLED_DC    16
#define OLED_CS     5
#define PIN_LED     2

uint8_t ADC_PIN[2] = { 34, 35 };                       // stick X, stick Y
// 0 Up, 1 Down, 2 Left, 3 Right, 4 Center, 5 stick click
uint8_t BTN_PIN[6] = { 27, 26, 25, 33, 32, 13 };
const uint8_t POS_CAND[5] = { 25, 26, 27, 32, 33 };    // pins of the five "+" buttons
#define B_UP     0
#define B_DOWN   1
#define B_LEFT   2
#define B_RIGHT  3
#define B_CENTER 4
#define B_CLICK  5
#define B_JUMP   B_UP        // Dino
#define B_DUCK   B_DOWN

