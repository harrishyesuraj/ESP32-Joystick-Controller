// ============================== INPUT =====================================
// median of 7 reads (after 3 dummy reads to flush the ADC multiplexer) removes spikes and channel crosstalk
int readAdc(uint8_t pin) {
  analogRead(pin); analogRead(pin); analogRead(pin);
  int v[7];
  for (int i = 0; i < 7; i++) v[i] = analogRead(pin);
  for (int i = 1; i < 7; i++) { int k = v[i], j = i - 1; while (j >= 0 && v[j] > k) { v[j + 1] = v[j]; j--; } v[j + 1] = k; }
  return v[3];
}
float filt[2]; bool filtInit = false;

// normalised -1..1 for one ADC channel, sign = raw direction (below / above centre)
float chNorm(const Cal& c, uint8_t ch, int raw) {
  float v;
  if (raw >= c.ct[ch]) { float sp = c.mx[ch] - c.ct[ch]; v = sp > 50 ? (raw - c.ct[ch]) / sp : 0; }
  else                 { float sp = c.ct[ch] - c.mn[ch]; v = sp > 50 ? -(float)(c.ct[ch] - raw) / sp : 0; }
  v = constrain(v, -1.0f, 1.0f);
  float a = fabsf(v);
  if (a < DEADZONE) return 0;
  a = (a - DEADZONE) / (1.0f - DEADZONE);
  return v < 0 ? -a : a;
}
// logical axis (0 X, 1 Y): right = +, down = + (up = -), using the learned orientation
float logAxis(const Cal& c, uint8_t L) { uint8_t ch = ori.src[L]; return chNorm(c, ch, rawAx[ch]) * ori.sgn[L]; }

void pushEv(uint8_t e) { if (evn < sizeof(evq)) evq[evn++] = e; }

