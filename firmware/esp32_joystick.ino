void drawGhost(int g) {
  Ent& e = gh[g];
  int x0 = PAC_OX + (int)((e.tx + e.dx * e.p) * PT), y0 = PAC_OY + (int)((e.ty + e.dy * e.p) * PT);
  bool fr = ghFr[g] && pacT < frightEnd;
  bool flash = fr && (frightEnd - pacT) < 1500 && ((pacT / 150) % 2);
  if (fr && !flash) {
    display.drawRect(x0, y0 + 1, 6, 5, WHITE);
    display.drawPixel(x0 + 1, y0 + 3, WHITE); display.drawPixel(x0 + 4, y0 + 3, WHITE);
  } else {
    display.fillRect(x0 + 1, y0, 4, 1, WHITE); display.fillRect(x0, y0 + 1, 6, 5, WHITE);
    display.drawPixel(x0 + 1, y0 + 5, BLACK); display.drawPixel(x0 + 4, y0 + 5, BLACK);
    display.drawPixel(x0 + 1 + (e.dx > 0), y0 + 2, BLACK); display.drawPixel(x0 + 3 + (e.dx > 0), y0 + 2, BLACK);
  }
}
void drawPacman(int cx, int cy, int fx, int fy, bool mouth) {
  display.fillCircle(cx, cy, 2, WHITE);
  if (mouth) {
    display.drawLine(cx, cy, cx + fx * 3, cy + fy * 3, BLACK);
    display.drawPixel(cx + fx * 2 + fy, cy + fy * 2 + fx, BLACK);
    display.drawPixel(cx + fx * 2 - fy, cy + fy * 2 - fx, BLACK);
  }
}
void drawPacField() {
  for (int y = 0; y < PAC_H; y++) for (int x = 0; x < PAC_W; x++) {
    int px = PAC_OX + x * PT, py = PAC_OY + y * PT; uint8_t v = pacCell[y][x];
    if (v == 9) {
      display.fillRect(px + 2, py + 2, 2, 2, WHITE);
      if (x + 1 < PAC_W && pacCell[y][x + 1] == 9) display.fillRect(px + 2, py + 2, 6, 2, WHITE);
      if (y + 1 < PAC_H && pacCell[y + 1][x] == 9) display.fillRect(px + 2, py + 2, 2, 6, WHITE);
    } else if (v == 1) display.drawPixel(px + 3, py + 3, WHITE);
    else if (v == 2) display.fillCircle(px + 3, py + 3, ((pacT / 200) % 2) ? 2 : 1, WHITE);
  }
  float fx = pac.tx + pac.dx * pac.p, fy = pac.ty + pac.dy * pac.p;
  drawPacman(PAC_OX + (int)(fx * PT) + 3, PAC_OY + (int)(fy * PT) + 3, faceX, faceY, (pacT / 120) % 2);
  drawGhost(0); drawGhost(1);
  P(0, 0, "%05lu", (unsigned long)pacScore);
  P(0, 8, "LV%u", pacLevel);
  for (int i = 0; i < pacLives; i++) display.fillCircle(122 - i * 8, 3, 2, WHITE);
}
