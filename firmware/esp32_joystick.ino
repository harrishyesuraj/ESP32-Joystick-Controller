// ============================== HELPERS ===================================
void P(uint8_t r, uint8_t c, const char* f, ...) {
  char b[40]; va_list a; va_start(a, f); vsnprintf(b, sizeof b, f, a); va_end(a);
  display.setCursor(c * 6, r * 8); display.print(b);
}
void PR(uint8_t r, const char* s) {                 // right aligned
  display.setCursor((21 - strlen(s)) * 6, r * 8); display.print(s);
}
void PCtr(int y, const char* s, uint8_t sz) {       // centred, pixel y
  int w = strlen(s) * 6 * sz;
  display.setTextSize(sz); display.setCursor((SCREEN_W - w) / 2, y); display.print(s);
  display.setTextSize(1);
}
void header(const char* t, const char* right) {
  display.fillRect(0, 0, 128, 8, WHITE); display.setTextColor(BLACK);
  P(0, 0, "%s", t); if (right) PR(0, right);
  display.setTextColor(WHITE);
}
void footer(const char* s) { P(7, 0, "%s", s); }
void itemY(int y, int x0, int w, const char* s, const char* val, bool sel) {
  if (sel) { display.fillRect(x0, y, w, 8, WHITE); display.setTextColor(BLACK); }
  display.setCursor(x0 + 2, y); display.print(sel ? ">" : " "); display.print(" "); display.print(s);
  if (val) { display.setCursor(x0 + w - 2 - strlen(val) * 6, y); display.print(val); }
  display.setTextColor(WHITE);
}
void item(uint8_t r, const char* s, const char* val, bool sel) { itemY(r * 8, 0, 128, s, val, sel); }
void cellBar(int x, int y, int filled, int total, int cw, int ch) {
  for (int i = 0; i < total; i++) {
    if (i < filled) display.fillRect(x + i * (cw + 1), y, cw, ch, WHITE);
    else            display.drawRect(x + i * (cw + 1), y, cw, ch, WHITE);
  }
}
// Nokia-style menu: one boxed list, up to 5 rows, vertical scroll bar on the right
void drawBoxList(const char* const* names, uint8_t n, uint8_t sel, const char* const* vals) {
  display.drawRect(0, 9, 128, 44, WHITE);
  const int vis = 5; int top = sel < vis ? 0 : sel - vis + 1;
  for (int k = 0; k < vis && top + k < n; k++)
    itemY(10 + k * 8, 2, 116, names[top + k], vals ? vals[top + k] : NULL, top + k == sel);
  int th = 40 / n; if (th < 6) th = 6; if (th > 40) th = 40;
  int ty = n > 1 ? 10 + (40 - th) * sel / (n - 1) : 10;
  display.drawFastVLine(122, 10, 40, WHITE);          // track
  display.fillRect(120, ty, 5, th, WHITE);            // thumb
}
void drawStickBox(int x, int y, float sx, float sy, int sz = 32) {
  display.drawRect(x, y, sz, sz, WHITE);
  int h = sz / 2, r = h - 3;
  display.fillRect(x + h + (int)(sx * r) - 1, y + h + (int)(sy * r) - 1, 3, 3, WHITE);
}
// elapsed ms, never negative (timestamps taken inside a loop pass can be newer than the pass's 'now')
static inline uint32_t since(uint32_t now, uint32_t t) { return (int32_t)(now - t) < 0 ? 0 : now - t; }
void setContrast(uint8_t v) { display.ssd1306_command(SSD1306_SETCONTRAST); display.ssd1306_command(v); }
void applyBrightness() { setContrast(CONTRAST[constrain(cfg.bri, 1, 5) - 1]); }
void setLed(bool on) { static int8_t last = -1; if (last != (int8_t)on) { digitalWrite(PIN_LED, on); last = on; } }

