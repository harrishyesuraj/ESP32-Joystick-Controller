bool inList(uint8_t p, const uint8_t* l, int n) { for (int i = 0; i < n; i++) if (l[i] == p) return true; return false; }
void applyPins() {
  for (int i = 0; i < 5; i++) pinMode(POS_CAND[i], INPUT);
  for (int i = 0; i < 6; i++) pinMode(BTN_PIN[i], INPUT_PULLUP);
  for (int i = 0; i < 2; i++) pinMode(ADC_PIN[i], INPUT);
}
bool rdBtn(uint8_t i) { return digitalRead(BTN_PIN[i]) == LOW; }
void loadPins() {                                       // positions chosen in Settings > Button positions
  uint8_t b[5];
  if (prefs.getBytesLength("bpin") != 5) return;
  prefs.getBytes("bpin", b, 5);
  for (int i = 0; i < 5; i++) { if (!inList(b[i], POS_CAND, 5)) return; for (int j = i + 1; j < 5; j++) if (b[i] == b[j]) return; }
  memcpy(BTN_PIN, b, 5);
}

void loadSettings() {
  prefs.begin("ctrl", false);
  defaultsConfig(); defaultsCal(); defaultsOri(); calValid = false; oriSet = false;
  uint8_t ver = prefs.getUChar("ver", 0);
  if (ver == 0 || ver > SETTINGS_VER) {                 // first start / unknown layout
    prefs.clear(); prefs.putUChar("ver", SETTINGS_VER);
    saveMap(); saveDisplay(); saveLedCfg(); savePad(); saveHi(); savePhi(); saveShi();
    return;
  }
  if (prefs.getBytesLength("map") == 6) prefs.getBytes("map", cfg.map, 6);
  cfg.bri = prefs.getUChar("bri", 4);
  cfg.tmo = prefs.getUChar("tmo", 2);
  cfg.led = prefs.getUChar("led", 2);
  cfg.pad = prefs.getUChar("pad", USE_XINPUT ? 0 : 1);
  cfg.yinv = prefs.getUChar("yinv", 0);
  cfg.hi  = prefs.getUInt("hi", 0);
  cfg.phi = prefs.getUInt("phi", 0);
  cfg.shi = prefs.getUInt("shi", 0);
  if (prefs.getBytesLength("cal") == sizeof(cal)) { prefs.getBytes("cal", &cal, sizeof(cal)); calValid = true; }
  if (prefs.getBytesLength("ori") == sizeof(ori)) {
    Orient o; prefs.getBytes("ori", &o, sizeof(o));
    if (o.src[0] < 2 && o.src[1] < 2 && o.src[0] != o.src[1] && (o.sgn[0] == 1 || o.sgn[0] == -1) && (o.sgn[1] == 1 || o.sgn[1] == -1)) { ori = o; oriSet = true; }
  }
  loadPins();
  if (ver < 4) {                                        // new architecture: new controls, new defaults
    memcpy(cfg.map, DEF_MAP, 6); cfg.pad = USE_XINPUT ? 0 : 1; cfg.yinv = 0; saveMap(); savePad();
    prefs.remove("pins"); prefs.putUChar("ver", SETTINGS_VER);
  }
  for (int i = 0; i < 6; i++) if (cfg.map[i] > 20) cfg.map[i] = DEF_MAP[i];
  if (cfg.pad > 2 || (!USE_XINPUT && cfg.pad == 0)) cfg.pad = USE_XINPUT ? 0 : 1;
  cfg.bri = constrain(cfg.bri, 1, 5); if (cfg.tmo > 3) cfg.tmo = 2; if (cfg.led > 3) cfg.led = 2; if (cfg.yinv > 1) cfg.yinv = 0;
}

