// ============================== CALIBRATION ===============================
// Settings > Calibration > Calibrate range: sweep the stick, watch the box.
//   Up button = set centre (stick released)   Down button = restart range   Right = save   Center = cancel
#define CAL_REACH 1100
void applyCentreC(Cal& c, int i, int v, bool resetRange) {
  c.ct[i] = v;
  if (resetRange) { c.mn[i] = c.mx[i] = v; return; }
  if (c.mn[i] > v - 100) c.mn[i] = v > 1500 ? v - 1500 : 0;       // keep ordering sane
  if (c.mx[i] < v + 100) c.mx[i] = v < 2595 ? v + 1500 : 4095;
}
// averages 80 samples per channel (~0.4 s); optionally also returns the noise (max-min) per channel
void calMeasureCentre(int out[2], int noise[2] = NULL) {
  long sum[2] = { 0, 0 }; int mn[2] = { 4095, 4095 }, mx[2] = { 0, 0 };
  for (int k = 0; k < 80; k++) {
    for (int i = 0; i < 2; i++) { int v = readAdc(ADC_PIN[i]); sum[i] += v; if (v < mn[i]) mn[i] = v; if (v > mx[i]) mx[i] = v; }
    delay(5);
  }
  for (int i = 0; i < 2; i++) { out[i] = sum[i] / 80; if (noise) noise[i] = mx[i] - mn[i]; }
}
void softCentre(bool resetRange) {          // quiet re-centre of the active calibration (reset)
  int c[2]; calMeasureCentre(c);
  for (int i = 0; i < 2; i++) {
    if (resetRange) { cal.ct[i] = c[i]; cal.mn[i] = c[i] > 1700 ? c[i] - 1700 : 0; cal.mx[i] = c[i] < 2395 ? c[i] + 1700 : 4095; }
    else applyCentreC(cal, i, c[i], false);
  }
  hiCentre = (c[0] > 2700 || c[1] > 2700);
}
int needL(int i) { int a = (int)(tcal.ct[i] * 0.7f);          return a < CAL_REACH ? a : CAL_REACH; }
int needR(int i) { int a = (int)((4095 - tcal.ct[i]) * 0.7f); return a < CAL_REACH ? a : CAL_REACH; }
float progL(int i) { int n = needL(i); if (n < 50) return 1; float v = (tcal.ct[i] - tcal.mn[i]) / (float)n; return v > 1 ? 1 : v; }
float progR(int i) { int n = needR(i); if (n < 50) return 1; float v = (tcal.mx[i] - tcal.ct[i]) / (float)n; return v > 1 ? 1 : v; }
int calPct(int i) { float p = progL(i) < progR(i) ? progL(i) : progR(i); return (int)(p * 100); }

void calCentreNow(bool resetRange) {
  int c[2]; calMeasureCentre(c);
  for (int i = 0; i < 2; i++) applyCentreC(tcal, i, c[i], resetRange);
  hiCentre = (c[0] > 2700 || c[1] > 2700);
  calWarn = false;
}
void calEnter() { tcal = cal; calCentreNow(!calValid); gotoScr(SC_CAL); }
void calExit()   { gotoScr(SC_CALMENU); }
void calCancel() { gotoScr(SC_CALMENU); }
void calTrack() {
  for (int i = 0; i < 2; i++) {
    if (rawAx[i] < tcal.mn[i]) tcal.mn[i] = rawAx[i];
    if (rawAx[i] > tcal.mx[i]) tcal.mx[i] = rawAx[i];
  }
}
void calSave() {
  bool low = false; for (int i = 0; i < 2; i++) if (calPct(i) < 50) low = true;
  if (low && !calWarn) { calWarn = true; needRedraw = true; return; }   // first OK warns, second OK saves anyway
  cal = tcal; saveCal(); calValid = true; calExit();
}

// ---- Orientation: push the stick UP, DOWN, LEFT, RIGHT; whatever you push defines the directions ----
uint8_t oStep = 0, oPhase = 0; int oRest[2], oNoise[2]; uint32_t oT = 0, oAt = 0;
int8_t oCh[4], oSg[4]; bool oPass = false; char oMsg[22];
const char* const O_DIR[4] = { "UP", "DOWN", "LEFT", "RIGHT" };

void oriEvaluate() {
  oPass = true; oMsg[0] = 0;
  int chU = oCh[0], sU = oSg[0], chD = oCh[1], sD = oSg[1], chL = oCh[2], sL = oSg[2], chR = oCh[3], sR = oSg[3];
  if (chU != chD || sU == sD)      { oPass = false; snprintf(oMsg, 22, "UP/DOWN differ"); }
  else if (chL != chR || sL == sR) { oPass = false; snprintf(oMsg, 22, "LEFT/RIGHT differ"); }
  else if (chU == chR)             { oPass = false; snprintf(oMsg, 22, "X and Y same wire"); }
  else { ori.src[0] = chR; ori.sgn[0] = sR; ori.src[1] = chU; ori.sgn[1] = -sU; oriSet = true; saveOri(); }
}
void oriStart() {
  calMeasureCentre(oRest, oNoise);
  oStep = 0; oPhase = 0; oT = millis(); oAt = 0; oPass = false;
  gotoScr(SC_ORIENT);
}
void oriTick(uint32_t now) {
  if (oStep >= 4) return;
  int da = rawAx[0] - oRest[0], db = rawAx[1] - oRest[1];
  int tha = 3 * oNoise[0] > 900 ? 3 * oNoise[0] : 900, thb = 3 * oNoise[1] > 900 ? 3 * oNoise[1] : 900;
  if (oPhase == 0) {                                   // wait until the stick is released
    if (abs(da) < tha / 3 && abs(db) < thb / 3) { if (!oAt) oAt = now; if (since(now, oAt) >= 300) { oPhase = 1; oAt = 0; needRedraw = true; } }
    else oAt = 0;
  } else if (oPhase == 1) {                            // wait for a clear push
    if (abs(da) >= tha || abs(db) >= thb) {
      if (!oAt) oAt = now;
      if (since(now, oAt) >= 120) {
        bool useA = (long)abs(da) * thb >= (long)abs(db) * tha;
        int ch = useA ? 0 : 1, dev = useA ? da : db;
        oCh[oStep] = ch; oSg[oStep] = dev > 0 ? 1 : -1;
        oPhase = 2; oT = now; oAt = 0; needRedraw = true;
      }
    } else oAt = 0;
  } else if (since(now, oT) >= 500) {                  // show "got it" briefly, next direction
    oStep++; oPhase = 0; oAt = 0; needRedraw = true;
    if (oStep >= 4) oriEvaluate();
  }
}

// ---- Button positions: press Up, Down, Left, Right, Center in turn (which of the 5 wired buttons is which) ----
const char* const POS_NAME[5] = { "UP", "DOWN", "LEFT", "RIGHT", "CENTER" };
uint8_t posStep = 0, posPhase = 0; uint8_t posPin[5]; uint32_t posT = 0, posAt = 0, posCancelT = 0, posLowT[5]; bool posDone = false;

void posStart() {
  for (int i = 0; i < 5; i++) { pinMode(POS_CAND[i], INPUT_PULLUP); posPin[i] = 255; posLowT[i] = 0; }
  posStep = 0; posPhase = 0; posDone = false; posT = millis(); posAt = 0; posCancelT = 0;
  gotoScr(SC_POS);
}
void posApply() { for (int i = 0; i < 5; i++) BTN_PIN[i] = posPin[i]; savePins(); applyPins(); }
void posTick(uint32_t now) {
  if (posDone) {                                       // all five learned: ANY "+" button saves, the stick click cancels
    if (since(now, posT) < 700) return;                // ignore the release of the last press
    for (int i = 0; i < 5; i++) if (pressEdge[i]) { posApply(); gotoScr(SC_SETTINGS); return; }
    if (pressEdge[B_CLICK]) { applyPins(); gotoScr(SC_SETTINGS); }
    return;
  }
  if (btn[B_CLICK]) { if (!posCancelT) posCancelT = now; else if (since(now, posCancelT) >= 2000) { applyPins(); gotoScr(SC_SETTINGS); return; } } else posCancelT = 0;   // hold the stick click to cancel
  if (posPhase == 0) {                                 // wait until all five are released
    bool anyLow = false; for (int i = 0; i < 5; i++) if (digitalRead(POS_CAND[i]) == LOW) anyLow = true;
    if (anyLow) posT = now; else if (since(now, posT) >= 400) { posPhase = 1; needRedraw = true; }
  } else if (posPhase == 1) {                          // wait for a press on a pin not used yet
    for (int i = 0; i < 5; i++) {
      bool used = false; for (int j = 0; j < posStep; j++) if (posPin[j] == POS_CAND[i]) used = true;
      if (used) continue;
      if (digitalRead(POS_CAND[i]) == LOW) {
        if (!posLowT[i]) posLowT[i] = now;
        if (since(now, posLowT[i]) >= 40) { posPin[posStep] = POS_CAND[i]; posPhase = 2; posT = now; needRedraw = true; break; }
      } else posLowT[i] = 0;
    }
  } else if (posPhase == 2) {
    if (since(now, posT) >= 600) { posPhase = 3; posAt = 0; needRedraw = true; }
  } else {                                             // wait for release, then next
    bool anyLow = false; for (int i = 0; i < 5; i++) if (digitalRead(POS_CAND[i]) == LOW) anyLow = true;
    if (anyLow) posAt = 0;
    else {
      if (!posAt) posAt = now;
      if (since(now, posAt) >= 200) {
        posStep++; posAt = 0; posPhase = 1; needRedraw = true;
        for (int i = 0; i < 5; i++) posLowT[i] = 0;
        if (posStep >= 5) { posDone = true; posT = now; }
      }
    }
  }
}

// ============================== DINO GAME =================================
void startGame() {
  for (auto& o : obs) o.on = false;
  dinoH = dinoV = 0; ducking = false; score = 0; distM = 0; dinoLevel = 0; newHi = false;
  gameSpeed = 60; nextGap = 80; animMs = 0;
  gotoScr(SC_DINO_PLAY);
}
void gameOver() {
  newHi = score > cfg.hi;
  if (newHi) { cfg.hi = score; saveHi(); }
  overT = millis(); gotoScr(SC_DINO_OVER);
}
void gameInput() {                      // every loop pass: low-latency jump/duck
  bool up = btn[B_JUMP] || ax[1] < -0.5f, dn = btn[B_DUCK] || ax[1] > 0.5f;
  bool ground = (dinoH <= 0.01f && dinoV <= 0);
  if (up && ground) { dinoV = JUMP_V; dinoH = 0.5f; }
  ducking = dn && ground;
}
void gameStep(float dt) {
  if (dt > 0.1f) dt = 0.1f;
  animMs += (uint32_t)(dt * 1000.0f + 0.5f);
  if (dinoH > 0 || dinoV > 0) {
    bool dn = btn[B_DUCK] || ax[1] > 0.5f;
    dinoV -= GRAV * (dn ? 2.0f : 1.0f) * dt; dinoH += dinoV * dt;
    if (dinoH <= 0) { dinoH = 0; dinoV = 0; }
  }
  uint32_t lvl = dinoLevel > 10 ? 10 : dinoLevel;
  gameSpeed = 60 + 8 * lvl;                          // faster every 100 m
  distM += gameSpeed * dt / PX_PER_M; score = (uint32_t)distM;
  if (score >= (dinoLevel + 1) * LEVEL_METERS) {     // crossed 100 m, 200 m ...
    dinoLevel++;
    for (auto& o : obs) o.on = false;                // clear the track after the animation
    nextGap = 90;
    startLevelUp(SC_DINO_PLAY);
    return;
  }

  float rightmost = -1000; bool any = false;
  for (auto& o : obs) if (o.on) {
    o.x -= gameSpeed * dt;
    if (o.x + OW[o.type] < 0) o.on = false;
    else { any = true; float re = o.x + OW[o.type]; if (re > rightmost) rightmost = re; }
  }
  if (!any || (128 - rightmost) >= nextGap) {
    for (auto& o : obs) if (!o.on) {
      o.on = true; o.x = 128;
      o.type = (dinoLevel >= 1 && random(100) < 30) ? 3 : random(3);
      nextGap = random(80, 140) + gameSpeed * 0.5f;
      break;
    }
  }
  // collision
  float dx1, dx2, dB = dinoH, dT;
  if (ducking) { dx1 = DINO_X + 1; dx2 = DINO_X + 15; dT = dB + 9; }
  else         { dx1 = DINO_X + 4; dx2 = DINO_X + 11; dT = dB + 13; }
  for (auto& o : obs) if (o.on) {
    float ox1 = o.x + 1, ox2 = o.x + OW[o.type] - 1;
    float oB = (o.type == 3) ? BIRD_BOT : 0, oT = oB + OH[o.type];
    if (dx1 < ox2 && dx2 > ox1 && dB < oT && dT > oB) { gameOver(); return; }
  }
}

// ---- Dino drawing ----
void drawDino(int x, int yBottom, bool duck, bool run) {
  bool f = run && ((animMs / 120) % 2);
  if (!duck) {
    int y = yBottom - 16;
    display.fillRect(x + 6, y, 8, 6, WHITE);              // head
    display.drawPixel(x + 11, y + 1, BLACK);              // eye
    display.fillRect(x + 11, y + 4, 3, 1, BLACK);         // mouth
    display.fillRect(x + 3, y + 6, 9, 6, WHITE);          // body
    display.fillRect(x, y + 6, 3, 3, WHITE);              // tail
    display.fillRect(x + 12, y + 9, 2, 1, WHITE);         // arm
    display.fillRect(x + 4, y + 12, 2, f ? 4 : 2, WHITE); // legs
    display.fillRect(x + 9, y + 12, 2, f ? 2 : 4, WHITE);
  } else {
    int y = yBottom - 9;
    display.fillRect(x + 10, y, 7, 5, WHITE);             // head
    display.drawPixel(x + 14, y + 1, BLACK);
    display.fillRect(x, y + 3, 12, 4, WHITE);             // body
    display.fillRect(x + 2, y + 7, 2, f ? 2 : 1, WHITE);
    display.fillRect(x + 8, y + 7, 2, f ? 1 : 2, WHITE);
  }
}
void drawCactus(int x, int w, int h) {
  int y = GROUND_Y - h;
  display.fillRect(x + w / 2 - 1, y, 3, h, WHITE);
  display.fillRect(x, y + 4, 2, 5, WHITE);  display.fillRect(x, y + 8, w / 2, 1, WHITE);
  if (w >= 10) { display.fillRect(x + w - 2, y + 3, 2, 5, WHITE); display.fillRect(x + w / 2 + 1, y + 7, w / 2 - 1, 1, WHITE); }
}
void drawBird(int x, int bottomH) {
  int y = GROUND_Y - bottomH - 8;
  display.fillRect(x + 2, y + 3, 8, 3, WHITE);
  display.fillRect(x + 9, y + 2, 3, 3, WHITE); display.drawPixel(x + 12, y + 3, WHITE);
  display.drawPixel(x, y + 4, WHITE);
  if ((animMs / 150) % 2) display.fillRect(x + 4, y, 3, 3, WHITE); else display.fillRect(x + 4, y + 6, 3, 2, WHITE);
}
// ============================== PAC-MAN ===================================
#define PAC_W  21
#define PAC_H  9
#define PT     6            // tile size in pixels
#define PAC_OX 1
#define PAC_OY 10
const char* const PAC_MAZE[PAC_H] = {
  "#####################",
  "#o....#.......#....o#",
  "#.##.##.##.##.##.##.#",
  "#...................#",
  "#.#...#.#...#.#...#.#",
  "#...................#",
  "#.##.##.##.##.##.##.#",
  "#o....#.......#....o#",
  "#####################"
};
struct Ent { int8_t tx, ty, dx, dy; float p; };
Ent pac, gh[2];
bool ghFr[2];
uint32_t ghRel[2], pacT = 0, frightEnd = 0, freezeUntil = 0, pacScore = 0, pacOverT = 0;
uint8_t  pacCell[PAC_H][PAC_W];            // 0 empty, 1 dot, 2 pellet, 9 wall
uint16_t dotsLeft = 0;
uint8_t  pacLives = 3, pacLevel = 1;
int8_t   wantX = 0, wantY = 0, faceX = 1, faceY = 0;
bool     pacNewHi = false;
const int8_t GSX[2] = { 1, 19 }, GSY[2] = { 1, 1 };
const int8_t DX4[4] = { 0, 0, -1, 1 }, DY4[4] = { -1, 1, 0, 0 };

bool pFree(int x, int y) { return x >= 0 && x < PAC_W && y >= 0 && y < PAC_H && pacCell[y][x] != 9; }

void pacLoadMaze() {
  dotsLeft = 0;
  for (int y = 0; y < PAC_H; y++) for (int x = 0; x < PAC_W; x++) {
    char c = PAC_MAZE[y][x];
    uint8_t v = (c == '#') ? 9 : (c == '.' ? 1 : (c == 'o' ? 2 : 0));
    if (v == 1 || v == 2) dotsLeft++;
    pacCell[y][x] = v;
  }
  if (pacCell[7][10]) { pacCell[7][10] = 0; dotsLeft--; }   // Pac-Man start tile
}
void ghostHome(int g) { gh[g].tx = GSX[g]; gh[g].ty = GSY[g]; gh[g].dx = gh[g].dy = 0; gh[g].p = 0; ghFr[g] = false; }
void pacResetPos() {
  pac.tx = 10; pac.ty = 7; pac.dx = pac.dy = 0; pac.p = 0; wantX = wantY = 0; faceX = 1; faceY = 0;
  for (int g = 0; g < 2; g++) { ghostHome(g); ghRel[g] = pacT + 1500 + g * 2000; }
  frightEnd = 0;
}
void startPac() {
  pacScore = 0; pacLives = 3; pacLevel = 1; pacNewHi = false; pacT = 0;
  pacLoadMaze(); pacResetPos(); freezeUntil = 1200;
  gotoScr(SC_PAC_PLAY);
}
void pacOver() {
  pacNewHi = pacScore > cfg.phi;
  if (pacNewHi) { cfg.phi = pacScore; savePhi(); }
  pacOverT = millis(); gotoScr(SC_PAC_OVER);
}

void ghostChoose(int g) {
  Ent& e = gh[g];
  bool fr = ghFr[g] && pacT < frightEnd;
  int8_t cx[4], cy[4]; int n = 0;
  for (int d = 0; d < 4; d++) {
    if (!pFree(e.tx + DX4[d], e.ty + DY4[d])) continue;
    if ((e.dx || e.dy) && DX4[d] == -e.dx && DY4[d] == -e.dy) continue;   // no U-turns
    cx[n] = DX4[d]; cy[n] = DY4[d]; n++;
  }
  if (n == 0) {
    if (pFree(e.tx - e.dx, e.ty - e.dy) && (e.dx || e.dy)) { e.dx = -e.dx; e.dy = -e.dy; }
    else e.dx = e.dy = 0;
    return;
  }
  int pick = 0;
  if (fr || random(100) < 20) pick = random(n);
  else {
    int best = 9999;
    for (int k = 0; k < n; k++) {
      int dd = abs(e.tx + cx[k] - pac.tx) + abs(e.ty + cy[k] - pac.ty);
      if (dd < best) { best = dd; pick = k; }
    }
  }
  e.dx = cx[pick]; e.dy = cy[pick];
}

// returns true when the maze was cleared
bool pacEat() {
  uint8_t& c = pacCell[pac.ty][pac.tx];
  if (c == 1) { pacScore += 10; dotsLeft--; c = 0; }
  else if (c == 2) {
    pacScore += 50; dotsLeft--; c = 0;
    uint32_t len = 6000; uint32_t cut = 400UL * (pacLevel - 1); len = (len > cut + 2500) ? len - cut : 2500;
    frightEnd = pacT + len; ghFr[0] = ghFr[1] = true;
  }
  if (dotsLeft == 0) {
    pacLevel++; pacLoadMaze(); pacResetPos(); freezeUntil = pacT + 1000;
    return true;
  }
  return false;
}

void pacStep(float dt) {
  pacT += (uint32_t)(dt * 1000.0f + 0.5f);
  if (pacT < freezeUntil) return;

  // desired direction: Joystick 1 (dominant axis), or B1 up / B2 down
  int wx = 0, wy = 0;
  if (fabsf(ax[0]) > 0.5f || fabsf(ax[1]) > 0.5f) {
    if (fabsf(ax[0]) > fabsf(ax[1])) wx = ax[0] > 0 ? 1 : -1; else wy = ax[1] > 0 ? 1 : -1;
  } else if (btn[B_UP]) wy = -1;
  else if (btn[B_DOWN]) wy = 1;
  else if (btn[B_LEFT]) wx = -1;
  else if (btn[B_RIGHT]) wx = 1;
  if (wx || wy) { wantX = wx; wantY = wy; }

  float spd = 5.0f + 0.2f * (pacLevel - 1); if (spd > 6.0f) spd = 6.0f;
  float gsp = 3.4f + 0.25f * (pacLevel - 1); if (gsp > 4.8f) gsp = 4.8f;

  // instant reverse
  if ((wantX || wantY) && (pac.dx || pac.dy) && wantX == -pac.dx && wantY == -pac.dy) {
    pac.tx += pac.dx; pac.ty += pac.dy; pac.dx = wantX; pac.dy = wantY; pac.p = 1.0f - pac.p;
  }
  if (pac.dx == 0 && pac.dy == 0) {
    if ((wantX || wantY) && pFree(pac.tx + wantX, pac.ty + wantY)) { pac.dx = wantX; pac.dy = wantY; pac.p = 0; }
  } else {
    pac.p += spd * dt;
    while (pac.p >= 1.0f) {
      pac.p -= 1.0f; pac.tx += pac.dx; pac.ty += pac.dy;
      if (pacEat()) { startLevelUp(SC_PAC_PLAY); return; }
      if ((wantX || wantY) && pFree(pac.tx + wantX, pac.ty + wantY)) { pac.dx = wantX; pac.dy = wantY; }
      else if (!pFree(pac.tx + pac.dx, pac.ty + pac.dy)) { pac.dx = pac.dy = 0; pac.p = 0; break; }
    }
  }
  if (pac.dx || pac.dy) { faceX = pac.dx; faceY = pac.dy; }

  for (int g = 0; g < 2; g++) {
    if (pacT < ghRel[g]) continue;
    bool fr = ghFr[g] && pacT < frightEnd;
    float sp = fr ? 2.8f : gsp;
    Ent& e = gh[g];
    if (e.dx == 0 && e.dy == 0) { ghostChoose(g); e.p = 0; }
    else {
      e.p += sp * dt;
      while (e.p >= 1.0f) {
        e.p -= 1.0f; e.tx += e.dx; e.ty += e.dy; ghostChoose(g);
        if (e.dx == 0 && e.dy == 0) { e.p = 0; break; }
      }
    }
  }

  float px = pac.tx + pac.dx * pac.p, py = pac.ty + pac.dy * pac.p;
  for (int g = 0; g < 2; g++) {
    float gx = gh[g].tx + gh[g].dx * gh[g].p, gy = gh[g].ty + gh[g].dy * gh[g].p;
    if (fabsf(gx - px) + fabsf(gy - py) < 0.7f) {
      if (ghFr[g] && pacT < frightEnd) { pacScore += 200; ghostHome(g); ghRel[g] = pacT + 2000; }
      else {
        if (pacLives <= 1) { pacLives = 0; pacOver(); return; }
        pacLives--; pacResetPos(); freezeUntil = pacT + 1500; return;
      }
    }
  }
}

// ============================== SNAKE =====================================
#define SN_COLS 31
#define SN_ROWS 13
#define SN_X0   2
#define SN_Y0   10
#define SN_MAXLEN (SN_COLS * SN_ROWS)
uint8_t  snX[SN_MAXLEN], snY[SN_MAXLEN]; uint16_t snLen = 4;      // index 0 = head
int8_t   snDx = 1, snDy = 0, snNx = 1, snNy = 0;                   // current and queued direction
uint8_t  foodX = 5, foodY = 5;
uint32_t snScore = 0, snLevel = 0, snAccMs = 0, snEaten = 0, snOverT = 0, snAnim = 0; bool snNewHi = false;

void snPlaceFood() {
  for (int tries = 0; tries < 300; tries++) {
    uint8_t x = random(SN_COLS), y = random(SN_ROWS); bool on = false;
    for (uint16_t i = 0; i < snLen; i++) if (snX[i] == x && snY[i] == y) { on = true; break; }
    if (!on) { foodX = x; foodY = y; return; }
  }
  for (uint8_t y = 0; y < SN_ROWS; y++) for (uint8_t x = 0; x < SN_COLS; x++) {      // board almost full: scan
    bool on = false; for (uint16_t i = 0; i < snLen; i++) if (snX[i] == x && snY[i] == y) { on = true; break; }
    if (!on) { foodX = x; foodY = y; return; }
  }
}
void startSnake() {
  snLen = 4; for (int i = 0; i < 4; i++) { snX[i] = SN_COLS / 2 - i; snY[i] = SN_ROWS / 2; }
  snDx = snNx = 1; snDy = snNy = 0; snScore = 0; snLevel = 0; snEaten = 0; snAccMs = 0; snAnim = 0; snNewHi = false;
  snPlaceFood(); gotoScr(SC_SNAKE_PLAY);
}
void snakeOver() {
  snNewHi = snScore > cfg.shi;
  if (snNewHi) { cfg.shi = snScore; saveShi(); }
  snOverT = millis(); gotoScr(SC_SNAKE_OVER);
}
void snakeInput() {                                    // every loop pass: buttons or stick, no 180-degree turn
  int dx = 0, dy = 0;
  if (btn[B_UP]) dy = -1; else if (btn[B_DOWN]) dy = 1; else if (btn[B_LEFT]) dx = -1; else if (btn[B_RIGHT]) dx = 1;
  else if (fabsf(ax[0]) > 0.5f || fabsf(ax[1]) > 0.5f) { if (fabsf(ax[0]) > fabsf(ax[1])) dx = ax[0] > 0 ? 1 : -1; else dy = ax[1] > 0 ? 1 : -1; }
  if ((dx || dy) && !(dx == -snDx && dy == -snDy)) { snNx = dx; snNy = dy; }
}
void snakeStep(float dt) {
  uint32_t ms = (uint32_t)(dt * 1000.0f + 0.5f); snAccMs += ms; snAnim += ms;
  uint32_t lvl = snLevel > 10 ? 10 : snLevel; uint32_t interval = 170 - 9 * lvl;      // faster every 5 apples
  while (snAccMs >= interval) {
    snAccMs -= interval;
    snDx = snNx; snDy = snNy;
    int nx = snX[0] + snDx, ny = snY[0] + snDy;
    if (nx < 0 || nx >= SN_COLS || ny < 0 || ny >= SN_ROWS) { snakeOver(); return; }
    bool eat = (nx == foodX && ny == foodY);
    uint16_t chk = eat ? snLen : snLen - 1;            // the tail moves away unless we are growing
    for (uint16_t i = 0; i < chk; i++) if (snX[i] == nx && snY[i] == ny) { snakeOver(); return; }
    if (eat && snLen < SN_MAXLEN) snLen++;
    for (int i = snLen - 1; i > 0; i--) { snX[i] = snX[i - 1]; snY[i] = snY[i - 1]; }
    snX[0] = nx; snY[0] = ny;
    if (eat) {
      snScore += 10; snEaten++; snPlaceFood();
      if (snEaten % 5 == 0) { snLevel++; snAccMs = 0; startLevelUp(SC_SNAKE_PLAY); return; }
    }
  }
}
void drawSnakeField() {
  display.drawRect(0, 9, 128, 55, WHITE);
  int fx = SN_X0 + foodX * 4, fy = SN_Y0 + foodY * 4;
  display.drawRect(fx, fy, 4, 4, WHITE);
  if ((snAnim / 250) % 2) display.fillRect(fx + 1, fy + 1, 2, 2, WHITE);
  for (uint16_t i = 0; i < snLen; i++) {
    int x = SN_X0 + snX[i] * 4, y = SN_Y0 + snY[i] * 4;
    if (i == 0) display.fillRect(x, y, 4, 4, WHITE); else display.fillRect(x, y, 3, 3, WHITE);
  }
  display.fillRect(0, 0, 128, 8, BLACK);
  P(0, 0, "HI %05lu", (unsigned long)cfg.shi);
  P(0, 10, "LV%lu", (unsigned long)(snLevel + 1));
  char b[10]; snprintf(b, sizeof b, "%05lu", (unsigned long)snScore); PR(0, b);
}
void drawSnakeScr() {
  if (scr == SC_SNAKE_START) {
    P(0, 0, "HI %05lu", (unsigned long)cfg.shi);
    PCtr(14, "SNAKE", 2); PCtr(36, "PRESS START", 1);
    for (int k = 0; k < 7; k++) display.fillRect(26 + k * 5, 52, k == 6 ? 4 : 3, k == 6 ? 4 : 3, WHITE);
    display.drawRect(76, 52, 4, 4, WHITE); display.fillRect(77, 53, 2, 2, WHITE);
  } else if (scr == SC_SNAKE_PLAY) {
    drawSnakeField();
  } else if (scr == SC_SNAKE_PAUSE) {
    drawSnakeField();
    display.fillRect(20, 20, 88, 34, BLACK); display.drawRect(20, 20, 88, 34, WHITE);
    PCtr(24, "PAUSED", 1); PCtr(35, "START: resume", 1); PCtr(44, "BACK: quit", 1);
  } else {
    PCtr(8, "GAME OVER", 2);
    P(4, 0, "Score  %05lu", (unsigned long)snScore);
    if (snNewHi) P(5, 0, "NEW HI! %05lu", (unsigned long)cfg.shi); else P(5, 0, "HI     %05lu", (unsigned long)cfg.shi);
    P(6, 0, "START: retry"); P(7, 0, "BACK: games");
  }
}

