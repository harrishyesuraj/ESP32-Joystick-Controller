void render(uint32_t now) {
  display.clearDisplay(); display.setTextColor(WHITE); display.setTextSize(1); display.setTextWrap(false);
  switch (scr) {
    case SC_MENU: drawMenu(); break;
    case SC_GAMES: drawGames(); break;
    case SC_HOME_BT: drawHome(true); break;
    case SC_HOME_USB: drawHome(false); break;
    case SC_LINKTEST: drawLinkTest(); break;
    case SC_SETTINGS: drawSettings(); break;
    case SC_PADMODE: drawPadMode(); break;
    case SC_CALMENU: drawCalMenu(); break;
    case SC_CAL: drawCal(); break;
    case SC_ORIENT: drawOrient(); break;
    case SC_POS: drawPos(); break;
    case SC_MAPLIST: drawMapList(); break;
    case SC_MAPEDIT: drawMapEdit(); break;
    case SC_MONITOR: drawMonitor(); break;
    case SC_DISPLAY: drawDisplay(); break;
    case SC_LED: drawLedScr(); break;
    case SC_SYSTEM: drawSystem(); break;
    case SC_ABOUT: drawAbout(); break;
    case SC_CONFIRM: drawConfirm(); break;
    case SC_LOADING: drawLoading(now); break;
    case SC_LEVELUP: drawLevelUp(now); break;
    case SC_PAC_START: case SC_PAC_PLAY: case SC_PAC_PAUSE: case SC_PAC_OVER: drawPacScr(); break;
    case SC_SNAKE_START: case SC_SNAKE_PLAY: case SC_SNAKE_PAUSE: case SC_SNAKE_OVER: drawSnakeScr(); break;
    default: drawDinoScr(); break;
  }
  // hold-Center progress (Bluetooth / USB screens): replaces the footer
  if (menuHold && !menuFired && linkScreen() && !menuSwallow && since(now, menuT) >= 300) {
    display.fillRect(0, 56, 128, 8, BLACK);
    P(7, 0, "Menu");
    int cells = constrain((int)(since(now, menuT) * 10 / MENU_HOLD_MS), 0, 10);
    cellBar(34, 57, cells, 10, 6, 6);
  }
  display.display();
}

bool dynamicScreen(uint32_t now) {
  switch (scr) {
    case SC_HOME_BT: case SC_HOME_USB: case SC_LINKTEST: case SC_CAL: case SC_ORIENT: case SC_POS: case SC_MONITOR:
    case SC_DINO_PLAY: case SC_PAC_PLAY: case SC_SNAKE_PLAY: case SC_ABOUT: case SC_CONFIRM: case SC_LOADING: case SC_LEVELUP:
      return true;
    default: break;
  }
  return menuHold;
}

// ============================== EVENT HANDLING ============================
void restartNow() {
  savePad();
  display.clearDisplay(); display.setTextColor(WHITE); display.setTextSize(1);
  PCtr(16, "Restarting...", 1); PCtr(32, "Then pair it again", 1); PCtr(42, "in Bluetooth.", 1);
  display.display(); delay(1500); ESP.restart();
}

void doConfirm() {
  if (confKind == 1) { defaultsCal(); defaultsOri(); prefs.remove("cal"); prefs.remove("ori"); calValid = false; oriSet = false; softCentre(true); }
  else if (confKind == 2) { memcpy(cfg.map, DEF_MAP, 6); saveMap(); padChanged(); }
  else if (confKind == 3) { cfg.hi = 0; cfg.phi = 0; cfg.shi = 0; saveHi(); savePhi(); saveShi(); }
  else if (confKind == 4) { prefs.clear(); display.clearDisplay(); display.display(); delay(100); ESP.restart(); }
  gotoScr(confKind == 1 ? SC_CALMENU : SC_SYSTEM);
}

void handleEvent(uint8_t ev, uint32_t now) {
  switch (scr) {
    case SC_MENU:
      if (ev == EV_UP)   selMenu = (selMenu + 4) % 5;
      if (ev == EV_DOWN) selMenu = (selMenu + 1) % 5;
      if (ev == EV_BACK && retScr != SC_MENU) gotoScr(retScr);
      if (ev == EV_OK) {
        switch (selMenu) {
          case 0: openBt(); break;
          case 1: openUsb(); break;
          case 2: gotoScr(SC_GAMES); break;
          case 3: gotoScr(SC_SETTINGS); break;
          default: gotoScr(SC_ABOUT); break;
        }
      }
      break;

    case SC_GAMES:
      if (ev == EV_UP)   selGame = (selGame + GAME_COUNT - 1) % GAME_COUNT;
      if (ev == EV_DOWN) selGame = (selGame + 1) % GAME_COUNT;
      if (ev == EV_BACK) gotoScr(SC_MENU);
      if (ev == EV_OK)   startLoading(GAMES[selGame].startScr);
      break;

    case SC_HOME_BT: case SC_HOME_USB: if (ev == EV_MODE) openMenu(); break;
    case SC_LINKTEST: if (ev == EV_BACK) gotoScr(SC_SETTINGS); break;

    case SC_SETTINGS:
      if (ev == EV_UP)   selSet = (selSet + 8) % 9;
      if (ev == EV_DOWN) selSet = (selSet + 1) % 9;
      if (ev == EV_BACK) gotoScr(SC_MENU);
      if (ev == EV_OK) {
        switch (selSet) {
          case 0: gotoScr(SC_CALMENU); break;
          case 1: padRow = 0; gotoScr(SC_PADMODE); break;
          case 2: gotoScr(SC_MAPLIST); break;
          case 3: posStart(); break;
          case 4: gotoScr(SC_MONITOR); break;
          case 5: gotoScr(SC_DISPLAY); break;
          case 6: gotoScr(SC_LED); break;
          case 7: gotoScr(SC_LINKTEST); break;
          default: gotoScr(SC_SYSTEM); break;
        }
      }
      break;

    case SC_PADMODE:
      if (ev == EV_UP)   padRow = (padRow + 2) % 3;
      if (ev == EV_DOWN) padRow = (padRow + 1) % 3;
      if (ev == EV_LEFT || ev == EV_RIGHT || ev == EV_OK) {
        int d = (ev == EV_LEFT) ? -1 : 1;
        if (padRow == 0) {
          int lo = USE_XINPUT ? 0 : 1; int n = 3 - lo;
          cfg.pad = lo + ((cfg.pad - lo) + n + d) % n; padChanged();
        } else if (padRow == 1) {
          uint8_t cur = presetIndex(); uint8_t nxt = (cur == 3) ? 0 : (d > 0 ? (cur + 1) % 3 : (cur + 2) % 3);
          memcpy(cfg.map, PRESET[nxt], 6); saveMap(); padChanged();
        } else cfg.yinv ^= 1;
      }
      if (ev == EV_BACK) { savePad(); if (padNeedsRestart()) restartNow(); else gotoScr(SC_SETTINGS); }
      break;

    case SC_CALMENU:
      if (ev == EV_UP)   selCal = (selCal + 2) % 3;
      if (ev == EV_DOWN) selCal = (selCal + 1) % 3;
      if (ev == EV_BACK) gotoScr(SC_SETTINGS);
      if (ev == EV_OK) {
        if (selCal == 0) calEnter();
        else if (selCal == 1) oriStart();
        else { confKind = 1; gotoScr(SC_CONFIRM); }
      }
      break;
    case SC_CAL:
      if (ev == EV_UP)   calCentreNow(true);                                          // set centre (stick released), restart range
      if (ev == EV_DOWN) { for (int i = 0; i < 2; i++) tcal.mn[i] = tcal.mx[i] = tcal.ct[i]; calWarn = false; }   // restart range
      if (ev == EV_OK)   calSave();
      if (ev == EV_BACK) calCancel();
      break;
    case SC_ORIENT:
      if (ev == EV_BACK) gotoScr(SC_CALMENU);
      if (ev == EV_OK && oStep >= 4) { if (oPass) gotoScr(SC_CALMENU); else oriStart(); }
      break;
    case SC_POS: break;                                                                // handled in posTick()

    case SC_MAPLIST:
      if (ev == EV_UP)   selMap = (selMap + 5) % 6;
      if (ev == EV_DOWN) selMap = (selMap + 1) % 6;
      if (ev == EV_BACK) gotoScr(SC_SETTINGS);
      if (ev == EV_OK)   { mapTmp = cfg.map[selMap]; gotoScr(SC_MAPEDIT); }
      break;
    case SC_MAPEDIT:
      if (ev == EV_LEFT  || ev == EV_UP)   mapTmp = (mapTmp + 20) % 21;
      if (ev == EV_RIGHT || ev == EV_DOWN) mapTmp = (mapTmp + 1) % 21;
      if (ev == EV_BACK || ev == EV_OK) { cfg.map[selMap] = mapTmp; saveMap(); padChanged(); gotoScr(SC_MAPLIST); }   // Center or click saves
      break;

    case SC_MONITOR: if (ev == EV_BACK) gotoScr(SC_SETTINGS); break;

    case SC_DISPLAY:
      if (ev == EV_UP || ev == EV_DOWN) dispRow ^= 1;
      if (ev == EV_LEFT || ev == EV_RIGHT) {
        int d = (ev == EV_RIGHT) ? 1 : -1;
        if (dispRow == 0) { cfg.bri = constrain((int)cfg.bri + d, 1, 5); applyBrightness(); }
        else cfg.tmo = constrain((int)cfg.tmo + d, 0, 3);
      }
      if (ev == EV_BACK) { saveDisplay(); gotoScr(SC_SETTINGS); }
      break;

    case SC_LED:
      if (ev == EV_LEFT  || ev == EV_UP)   cfg.led = constrain((int)cfg.led - 1, 0, 3);
      if (ev == EV_RIGHT || ev == EV_DOWN) cfg.led = constrain((int)cfg.led + 1, 0, 3);
      if (ev == EV_BACK)  { saveLedCfg(); gotoScr(SC_SETTINGS); }
      break;

    case SC_SYSTEM:
      if (ev == EV_UP)   selSys = (selSys + 2) % 3;
      if (ev == EV_DOWN) selSys = (selSys + 1) % 3;
      if (ev == EV_BACK) gotoScr(SC_SETTINGS);
      if (ev == EV_OK)   { confKind = selSys + 2; gotoScr(SC_CONFIRM); }
      break;
    case SC_ABOUT: if (ev == EV_BACK) gotoScr(SC_MENU); break;
    case SC_CONFIRM:
      if (ev == EV_UP || ev == EV_DOWN) { selConf ^= 1; okHoldT = 0; }
      if (ev == EV_BACK) gotoScr(confKind == 1 ? SC_CALMENU : SC_SYSTEM);
      if (ev == EV_OK) {
        if (selConf == 0) gotoScr(confKind == 1 ? SC_CALMENU : SC_SYSTEM);
        else if (confKind != 4) doConfirm();
      }
      break;

    case SC_LOADING: break;                                      // plays for >= 0.6 s, then the game opens
    case SC_LEVELUP: if (ev == EV_OK) gotoScr(lvReturn); break;  // skip the animation

    case SC_DINO_START:
      if (ev == EV_OK) startGame();
      else if (ev == EV_BACK) gotoScr(SC_GAMES);
      break;
    case SC_DINO_PLAY: if (ev == EV_BACK) gotoScr(SC_DINO_PAUSE); break;
    case SC_DINO_PAUSE:
      if (ev == EV_OK) { lastFrame = now; gotoScr(SC_DINO_PLAY); }
      else if (ev == EV_BACK) gotoScr(SC_GAMES);
      break;
    case SC_DINO_OVER:
      if (ev == EV_OK) startGame();
      else if (ev == EV_BACK) gotoScr(SC_GAMES);
      break;

    case SC_PAC_START:
      if (ev == EV_OK) startPac();
      else if (ev == EV_BACK) gotoScr(SC_GAMES);
      break;
    case SC_PAC_PLAY: if (ev == EV_BACK) gotoScr(SC_PAC_PAUSE); break;
    case SC_PAC_PAUSE:
      if (ev == EV_OK) gotoScr(SC_PAC_PLAY);
      else if (ev == EV_BACK) gotoScr(SC_GAMES);
      break;
    case SC_PAC_OVER:
      if (ev == EV_OK) startPac();
      else if (ev == EV_BACK) gotoScr(SC_GAMES);
      break;

    case SC_SNAKE_START:
      if (ev == EV_OK) startSnake();
      else if (ev == EV_BACK) gotoScr(SC_GAMES);
      break;
    case SC_SNAKE_PLAY: if (ev == EV_BACK) gotoScr(SC_SNAKE_PAUSE); break;
    case SC_SNAKE_PAUSE:
      if (ev == EV_OK) gotoScr(SC_SNAKE_PLAY);
      else if (ev == EV_BACK) gotoScr(SC_GAMES);
      break;
    case SC_SNAKE_OVER:
      if (ev == EV_OK) startSnake();
      else if (ev == EV_BACK) gotoScr(SC_GAMES);
      break;
  }
}

// ============================== LED =======================================
void updateLed(uint32_t now) {
  bool on = false;
  switch (cfg.led) {
    case 0: on = false; break;
    case 1: on = true;  break;
    case 3: on = now < ledActUntil; break;
    default:
      if (linkMode == LINK_BT)       on = (btState == BT_CONN) ? true : ((now / 500) % 2 == 0);
      else if (linkMode == LINK_USB) on = usbConn ? true : ((now / 500) % 2 == 0);
      if (scr == SC_DINO_OVER || scr == SC_PAC_OVER || scr == SC_SNAKE_OVER) {
        uint32_t t = since(now, scr == SC_DINO_OVER ? overT : (scr == SC_PAC_OVER ? pacOverT : snOverT)); on = t < 300 && ((t / 100) % 2 == 0);
      }
  }
  setLed(on);
}

// ============================== BOOT ======================================
void bootWait(uint32_t ms) { uint32_t t = millis(); while (millis() - t < ms) yield(); }

void showLogo() {
  display.clearDisplay();
  display.drawBitmap(0, 0, phy_logo, 128, 64, SSD1306_WHITE);
  display.display();
}

void bootProgress(int pct, const char* st[4]) {
  display.clearDisplay(); display.setTextColor(WHITE); display.setTextSize(1);
  P(0, 0, "ESP32 CONTROLLER %s", FW_VERSION);
  P(2, 0, "Loading...");
  display.drawRect(0, 28, 90, 8, WHITE); display.fillRect(2, 30, (86 * pct) / 100, 4, WHITE);
  display.setCursor(96, 28); display.printf("%3d%%", pct);
  static const char* const N[4] = { "Display", "Settings", "Inputs", "Radio" };
  for (int i = 0; i < 4; i++) {
    char line[24]; int nl = strlen(N[i]), sl = strlen(st[i]);
    int dots = 21 - nl - sl - 2; if (dots < 1) dots = 1;
    int n = snprintf(line, sizeof line, "%s ", N[i]);
    for (int d = 0; d < dots; d++) line[n++] = '.';
    n += snprintf(line + n, sizeof line - n, " %s", st[i]);
    P(4 + i, 0, "%s", line);
  }
  display.display();
}

void bootSequence() {
  bootWait(150);                                           // stage 1: black
  showLogo();                                              // stage 2: logo, contrast fades up
  uint32_t t0 = millis(); uint8_t target = CONTRAST[cfg.bri - 1];
  while (millis() - t0 < 1000) {
    uint32_t e = millis() - t0;
    setContrast(e < 400 ? (uint8_t)(target * e / 400) : target);
    delay(10);
  }
  applyBrightness();
  display.clearDisplay(); display.setTextColor(WHITE);     // stage 3: splash
  PCtr(8, "ESP32", 3); PCtr(34, "GAME CONTROLLER", 1); PCtr(44, "STICK + 5 BUTTONS", 1);
  display.setTextSize(1); display.setCursor(128 - strlen(FW_VERSION) * 6, 56); display.print(FW_VERSION);
  display.display();
  bootWait(1150);
  if (cfg.led != 0) setLed(true);                          // stage 4: loading, real checks
  const char* st[4] = { "..", "..", "..", ".." };
  bootProgress(0, st);
  st[0] = "OK"; bootProgress(25, st); bootWait(350);
  st[1] = "OK"; bootProgress(50, st); bootWait(350);

  bool warn = false; hiCentre = false;
  for (int i = 0; i < 2; i++) {                            // stick: re-centre from the resting value, spot wiring / 5 V problems
    long s = 0; for (int k = 0; k < 32; k++) { s += readAdc(ADC_PIN[i]); delay(1); }
    int avg = s / 32;
    if (avg <= 5 || avg >= 4090) { warn = true; continue; }          // wire off or shorted
    if (avg > 2700) { hiCentre = true; warn = true; }                // centre too high: stick on 5 V?
    if (!calValid) { cal.ct[i] = avg; cal.mn[i] = avg > 1700 ? avg - 1700 : 0; cal.mx[i] = avg < 2395 ? avg + 1700 : 4095; }
    else if (abs(avg - cal.ct[i]) < 800) applyCentreC(cal, i, avg, false);
  }
  for (int i = 0; i < 6; i++) (void)rdBtn(i);
  st[2] = warn ? "WARN" : "OK";
  bootProgress(75, st); bootWait(350);
  st[3] = "OK";                                            // Bluetooth starts when you open it in the menu
  bootProgress(100, st); bootWait(350);
  display.clearDisplay(); display.setTextColor(WHITE);     // stage 5: ready
  P(0, 0, "ESP32 CONTROLLER %s", FW_VERSION);
  PCtr(24, "READY", 2);
  display.drawRect(0, 46, 90, 8, WHITE); display.fillRect(2, 48, 86, 4, WHITE);
  display.setCursor(96, 46); display.print("100%");
  display.display();
  if (cfg.led != 0) { setLed(false); bootWait(200); setLed(true); bootWait(200); }
  else bootWait(400);
}

// ============================== SETUP / LOOP ==============================
void setup() {
  pinMode(PIN_LED, OUTPUT); digitalWrite(PIN_LED, LOW);
  Serial.begin(115200);
  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);

  SPI.begin(OLED_SCK, -1, OLED_MOSI, OLED_CS);
  if (!display.begin(SSD1306_SWITCHCAPVCC)) {
    Serial.println("ERROR: SSD1306 OLED init failed - check SPI wiring (D0=18 D1=23 RES=17 DC=16 CS=5)");
    while (true) { digitalWrite(PIN_LED, !digitalRead(PIN_LED)); delay(100); }   // 5 Hz
  }
  display.clearDisplay(); display.display();
  setContrast(0);
  loadSettings();
  applyPins();
  randomSeed(esp_random());

  bootSequence();

  for (int i = 0; i < 6; i++) btn[i] = rdBtn(i);
  lastAct = lastFrame = millis();
  afterBoot();                                             // main menu
}

uint32_t simAcc = 0, lastSim = 0;

void loop() {
  uint32_t now = millis();

  bool act = readInputs(now);
  genEvents(now);
  updateLink(now);

  if (act) {                                               // a sleeping screen only wakes on the first input
    lastAct = now; ledActUntil = now + 50;
    if (!displayOn) { wakeDisplay(); evn = 0; if (pressEdge[B_CENTER]) menuSwallow = true; }
  }

  for (uint8_t i = 0; i < evn; i++) { handleEvent(evq[i], now); needRedraw = true; }
  now = millis();                                          // fresh time: screens changed above stamp millis()

  if (scr == SC_DINO_PLAY) gameInput();
  if (scr == SC_SNAKE_PLAY) snakeInput();
  if (scr == SC_CAL) calTrack();
  if (scr == SC_ORIENT) oriTick(now);
  if (scr == SC_POS) posTick(now);
  if (scr == SC_LOADING && since(now, loadT0) >= (uint32_t)LOAD_FRAME_MS * LOAD_FRAME_COUNT) gotoScr(loadTarget);
  if (scr == SC_LEVELUP && since(now, lvT0) >= (uint32_t)LEVELUP_FRAME_MS * LEVELUP_FRAMES) gotoScr(lvReturn);
  if (scr == SC_CONFIRM && confKind == 4 && selConf == 1) {          // factory reset: hold the click / Right button 2 s
    if (btn[B_CLICK] || btn[B_RIGHT]) { if (!okHoldT) okHoldT = now; else if (now - okHoldT >= 2000) doConfirm(); }
    else okHoldT = 0;
  }

  sendHost(now);
  updateLed(now);

  bool noSleep = (scr == SC_DINO_PLAY || scr == SC_PAC_PLAY || scr == SC_SNAKE_PLAY || scr == SC_CAL || scr == SC_MONITOR ||
                  scr == SC_LOADING || scr == SC_LEVELUP || scr == SC_LINKTEST || scr == SC_ORIENT || scr == SC_POS);
  if (displayOn && !noSleep && TIMEOUT_MS[cfg.tmo] && since(now, lastAct) > TIMEOUT_MS[cfg.tmo]) sleepDisplay();

  // fixed 10 ms simulation steps for both games (accurate jumps and collisions)
  if (scr == SC_DINO_PLAY || scr == SC_PAC_PLAY || scr == SC_SNAKE_PLAY) {
    uint32_t d = now - lastSim; if (d > 100) d = 100;
    simAcc += d;
    while (simAcc >= 10 && (scr == SC_DINO_PLAY || scr == SC_PAC_PLAY || scr == SC_SNAKE_PLAY)) {
      if (scr == SC_DINO_PLAY) gameStep(0.01f); else if (scr == SC_PAC_PLAY) pacStep(0.01f); else snakeStep(0.01f);
      simAcc -= 10;
    }
  } else simAcc = 0;
  lastSim = now;

  if (now - lastFrame >= FRAME_MS) {
    lastFrame = now;
    if (displayOn && (needRedraw || dynamicScreen(now))) { render(now); needRedraw = false; }
  }
  delay(1);
}
