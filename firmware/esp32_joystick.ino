void navStep(uint8_t d, float val, uint8_t ev, uint32_t now) {
  if (!navAct[d]) {
    if (val > NAV_ON) { navAct[d] = true; navNext[d] = now + NAV_REPEAT_1; pushEv(ev); }
  } else {
    if (val < NAV_OFF) navAct[d] = false;
    else if (now >= navNext[d]) { navNext[d] = now + NAV_REPEAT_N; pushEv(ev); }
  }
}

bool readInputs(uint32_t now) {
  bool act = false;
  for (int i = 0; i < 2; i++) {
    int m = readAdc(ADC_PIN[i]);
    if (!filtInit) filt[i] = m; else filt[i] += (m - filt[i]) * 0.30f;
    rawAx[i] = (int)(filt[i] + 0.5f);
  }
  filtInit = true;
  for (int L = 0; L < 2; L++) { ax[L] = logAxis(cal, L); if (ax[L] != 0) act = true; }
  for (int i = 0; i < 6; i++) {
    pressEdge[i] = relEdge[i] = false;
    bool raw = rdBtn(i);
    if (raw != btn[i] && now - btnT[i] >= DEBOUNCE_MS) {       // accept at once, then lock out 20 ms
      btn[i] = raw; btnT[i] = now;
      if (raw) { pressEdge[i] = true; act = true; } else relEdge[i] = true;
    }
  }
  return act;
}

void genEvents(uint32_t now) {
  evn = 0;
  bool lst = listScreen();
  if (stickNavScreen()) {
    navStep(0, -ax[1], EV_UP,    now);
    navStep(1,  ax[1], EV_DOWN,  now);
    navStep(2, -ax[0], EV_LEFT,  now);
    navStep(3,  ax[0], EV_RIGHT, now);
  }
  if (pressEdge[B_UP])    pushEv(EV_UP);
  if (pressEdge[B_DOWN])  pushEv(EV_DOWN);
  if (pressEdge[B_LEFT])  pushEv(lst ? EV_BACK : EV_LEFT);
  if (pressEdge[B_RIGHT]) pushEv(lst ? EV_OK : EV_RIGHT);
  if (pressEdge[B_CLICK] && clickOkScreen()) pushEv(EV_OK);
  if (pressEdge[B_CENTER] && !linkScreen()) pushEv(EV_BACK);

  // hold Center on the Bluetooth / USB screen = main menu (the press itself still goes to the game)
  if (pressEdge[B_CENTER]) { menuHold = true; menuFired = false; menuT = now; menuSwallow = !displayOn; }
  if (menuHold) {
    if (!btn[B_CENTER]) menuHold = false;
    else if (!menuFired && since(now, menuT) >= MENU_HOLD_MS && linkScreen() && !menuSwallow) { menuFired = true; pushEv(EV_MODE); }
  }
}

// ============================== BLUETOOTH / USB ===========================
void startBle() {
  if (bleStarted) return;
  BleGamepadConfiguration c;
#if USE_XINPUT
  if (cfg.pad == 0) {
    c.setGamepadMode(GamepadMode::XInputSeriesX);          // Xbox controller: set FIRST, it overwrites other settings
    c.setAutoReport(false);
    bleGamepad.begin(&c);
    bleStarted = true; bleMode = 0; return;
  }
#endif
  c.setAutoReport(false);
  c.setControllerType(CONTROLLER_TYPE_GAMEPAD);
  c.setVid(0xe502); c.setPid(0xabcd);
  c.setButtonCount(15);                                    // Android numbering needs up to 15
  c.setHatSwitchCount(1);                                  // the D-pad
  c.setWhichAxes(true, true, true, true, false, true, false, false);  // X Y Z RX RZ
  c.setAxesMin(0);
  c.setAxesMax(32767);
  bleGamepad.begin(&c);
  bleGamepad.setX(16383); bleGamepad.setY(16383); bleGamepad.setZ(16383); bleGamepad.setRX(16383); bleGamepad.setRZ(16383);
  bleStarted = true; bleMode = cfg.pad;
}
bool padNeedsRestart() { return bleStarted && ((bleMode == 0) != (cfg.pad == 0)); }   // Xbox <-> Generic changes the HID descriptor

// bit (t-1) = game button t:  1 A,2 B,3 X,4 Y,5 LB,6 RB,7 LT,8 RT,9 Select,10 Start,11 L3,12 R3,
//                              13-16 D-pad U/D/L/R, 17-20 left-stick U/D/L/R
uint32_t padMask() {
  uint32_t m = 0;
  for (int c = 0; c < 6; c++) if (btn[c] && cfg.map[c]) m |= (1UL << (cfg.map[c] - 1));
  return m;
}
uint8_t hatFrom(uint32_t m) {                              // 0 centred, 1 N, 2 NE, 3 E, 4 SE, 5 S, 6 SW, 7 W, 8 NW
  bool u = m & (1UL << 12), d = m & (1UL << 13), l = m & (1UL << 14), r = m & (1UL << 15);
  if (u && d) { u = d = false; } if (l && r) { l = r = false; }
  if (u) return r ? 2 : (l ? 8 : 1);
  if (d) return r ? 4 : (l ? 6 : 5);
  return r ? 3 : (l ? 7 : 0);
}
void btSend(uint32_t sm, int qx, int qy) {
  bool xb = (bleMode == 0) && USE_XINPUT;                  // the descriptor that is really running
  uint16_t hm = 0;
  for (int t = 1; t <= 12; t++) if (sm & (1UL << (t - 1))) {
    uint8_t n = xb ? XB_BTN[t] : (cfg.pad == 2 ? HID_AND[t] : HID_PC[t]);
    if (n) hm |= (1u << (n - 1));
  }
  for (int n = 1; n <= 15; n++) {
    bool want = hm & (1u << (n - 1)), had = lastHidMask & (1u << (n - 1));
    if (want && !had) bleGamepad.press(n);
    if (!want && had) bleGamepad.release(n);
  }
  lastHidMask = hm;
  int lx = ((sm >> 19) & 1) - ((sm >> 18) & 1), ly = ((sm >> 17) & 1) - ((sm >> 16) & 1);
  uint8_t hat = hatFrom(sm);
#if USE_XINPUT
  if (xb) {
    bleGamepad.setTriggers((sm & (1UL << 6)) ? 32767 : 0, (sm & (1UL << 7)) ? 32767 : 0);
    bleGamepad.setHat(hat);
    bleGamepad.setLeftThumb(lx * 32767, ly * 32767);
    bleGamepad.setRightThumb(qx * 520, qy * 520);          // 63 steps * 520 = full scale
    bleGamepad.sendReport();
    return;
  }
#endif
  bleGamepad.setHat1(hat);
  bleGamepad.setX(16383 + lx * 16383); bleGamepad.setY(16383 + ly * 16383);                // left stick (from buttons)
  bleGamepad.setZ(16383 + qx * 260);                                                      // right stick X
  if (cfg.pad == 1) { bleGamepad.setRX(16383 + qy * 260); bleGamepad.setRZ(16383); }       // PC: right stick Y on Rx
  else              { bleGamepad.setRZ(16383 + qy * 260); bleGamepad.setRX(16383); }       // Android: Rz
  bleGamepad.sendReport();
}
void padChanged() {                                        // layout/platform changed: release everything on the host
  if (bleStarted && !padNeedsRestart()) {
    for (int n = 1; n <= 15; n++) bleGamepad.release(n);
    btSend(0, 0, 0);
  }
  lastHidMask = 0; lastMask = 0; lastQ[0] = 99;
}

int quant(float v) { int s = (int)lroundf(v * 63.0f); return s > 63 ? 63 : (s < -63 ? -63 : s); }

// One frame to the active link. Sends on change (button changes at once, stick at most 40/s) and as a
// keep-alive (Bluetooth 100 ms, USB 500 ms) so a host that subscribes late still gets the current state.
void txFrame(uint32_t mask, int qx, int qy, uint32_t now) {
  bool btnCh = (mask != lastMask), axCh = (qx != lastQ[0] || qy != lastQ[1]);
  if (linkMode == LINK_BT) {
    if (!bleStarted || btState != BT_CONN) return;
    if (btnCh)       { if (now - lastHostT < 5)  return; }
    else if (axCh)   { if (now - lastHostT < 25) return; }
    else if (now - lastHostT < 100) return;
    btSend(mask, qx, qy); lastHostT = now;
  } else if (linkMode == LINK_USB) {
    if ((btnCh || axCh) ? (now - lastUsbT < HOST_MS) : (now - lastUsbT < 500)) return;
    Serial.printf("$,%d,%d,%lu\n", qx * 1000 / 63, qy * 1000 / 63, (unsigned long)mask);
    lastUsbT = now;
  } else return;
  lastMask = mask; lastQ[0] = qx; lastQ[1] = qy;
  txCount++; lastTxVis = now;
}

// automatic Link-test pattern: stick circles, then every game button in turn
void testState(uint32_t t, int& qx, int& qy, uint32_t& mask, int& sem) {
  float ang = t / 1500.0f * 6.2832f;
  qx = quant(cosf(ang) * 0.9f); qy = quant(sinf(ang) * 0.9f);
  int slot = (t / 500) % 21; sem = slot < 20 ? slot + 1 : 0;
  mask = sem ? (1UL << (sem - 1)) : 0;
}

void sendHost(uint32_t now) {
  if (linkMode == LINK_NONE) return;
  if (scr == SC_LINKTEST) { int qx, qy, sem; uint32_t m; testState(now - testT0, qx, qy, m, sem); txFrame(m, qx, qy, now); return; }
  bool home = (scr == SC_HOME_BT && linkMode == LINK_BT) || (scr == SC_HOME_USB && linkMode == LINK_USB);
  if (home) { int qy = quant(ax[1]) * (cfg.yinv ? -1 : 1); txFrame(padMask(), quant(ax[0]), qy, now); return; }
  if (lastMask != 0 || lastQ[0] != 0 || lastQ[1] != 0) txFrame(0, 0, 0, now);        // left the link screen: release everything once
}

void updateLink(uint32_t now) {
  if (bleStarted) {
    bool c = bleGamepad.isConnected();
    if (c && btState != BT_CONN) { btState = BT_CONN; lastMask = 0; lastHidMask = 0; lastQ[0] = 99; }   // force a full report
    else if (!c && btState == BT_CONN) { btState = BT_WAIT; lastMask = 0; }
  }
  if (linkMode == LINK_USB) {
    while (Serial.available()) { Serial.read(); usbLastMsg = now; }
    usbConn = usbLastMsg && (now - usbLastMsg < USB_TIMEOUT_MS);
  }
}

